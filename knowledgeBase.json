    "dataStructures": {
        "definition": "A data structure is a structured way of organizing, storing, processing, and retrieving data efficiently. It ensures data is arranged so both humans and machines can work with it easily.",
        "importance": {
            "correctStructure": [
                "Faster performance - Operations complete in milliseconds",
                "Less memory usage - Resources are optimized",
                "Scalable code - Systems grow without crashing"
            ],
            "wrongStructure": [
                "Slow applications - Loading times frustrate users",
                "High memory consumption - Devices run out of RAM",
                "Bad user experiences - Lags and crashes occur"
            ]
        },
