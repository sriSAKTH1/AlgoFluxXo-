    "complexity": {
        "timeComplexity": {
            "definition": "Measure of the amount of time an algorithm takes to complete as a function of input size",
            "notations": {
                "O(1)": {
                    "name": "Constant Time",
                    "description": "Execution time doesn't change with input size",
                    "examples": [
                        "Array access by index",
                        "Hash table lookup",
                        "Stack push/pop"
                    ]
                },
                "O(log n)": {
                    "name": "Logarithmic Time",
                    "description": "Time increases logarithmically with input size",
                    "examples": [
                        "Binary Search",
                        "Balanced tree operations"
                    ]
                },
                "O(n)": {
                    "name": "Linear Time",
                    "description": "Time increases linearly with input size",
                    "examples": [
                        "Linear Search",
                        "Array traversal",
                        "Finding min/max"
                    ]
                },
                "O(n log n)": {
                    "name": "Linearithmic Time",
                    "description": "Combination of linear and logarithmic",
                    "examples": [
                        "Merge Sort",
                        "Quick Sort (average)",
                        "Heap Sort"
                    ]
                },
                "O(n²)": {
                    "name": "Quadratic Time",
                    "description": "Time increases quadratically",
                    "examples": [
                        "Bubble Sort",
                        "Selection Sort",
                        "Insertion Sort",
                        "Nested loops"
                    ]
                },
                "O(n³)": {
                    "name": "Cubic Time",
                    "description": "Time increases cubically",
                    "examples": [
                        "Floyd-Warshall",
                        "Triple nested loops"
                    ]
                },
                "O(2^n)": {
                    "name": "Exponential Time",
                    "description": "Time doubles with each additional input",
                    "examples": [
                        "Recursive Fibonacci",
                        "Tower of Hanoi",
                        "Subset generation"
                    ]
                },
                "O(n!)": {
                    "name": "Factorial Time",
                    "description": "Extremely slow growth",
                    "examples": [
                        "Brute force TSP",
                        "Permutation generation"
                    ]
                }
            }
        },
        "spaceComplexity": {
            "definition": "Measure of memory space required by an algorithm as a function of input size",
            "components": [
                "Auxiliary Space: Extra space used by algorithm",
                "Input Space: Space required to store input"
            ],
            "examples": {
                "O(1)": "Iterative algorithms with few variables",
                "O(n)": "Recursive algorithms, additional arrays",
                "O(log n)": "Recursive binary search",
                "O(n²)": "2D arrays, adjacency matrix"
            }
        },
        "bestPractices": [
            "Always analyze both time and space complexity",
            "Consider average case, not just worst case",
            "Optimize bottlenecks, not entire code",
            "Trade-off between time and space when needed",
            "Use appropriate data structures for better complexity"
        ]
    },
