    "algorithms": {
        "definition": "An algorithm is a step-by-step procedure used to solve a problem or perform a task. It acts like a clear set of instructions that a computer follows to reach a result.",
        "characteristics": [
            {
                "name": "Clear & Unambiguous",
                "description": "Every instruction should be easy to understand and have only one interpretation"
            },
            {
                "name": "Well-Defined Inputs",
                "description": "If inputs are required, they must be clearly specified"
            },
            {
                "name": "Well-Defined Outputs",
                "description": "The expected result must be clearly defined before implementation"
            },
            {
                "name": "Finite Steps",
                "description": "The algorithm must end after a limited number of steps—no infinite loops"
            },
            {
                "name": "Feasible",
                "description": "It should be practical and executable with current technology and resources"
            },
            {
                "name": "Language-Independent",
                "description": "Written in plain logic. Produces the same output regardless of the programming language used"
            }
        ],
        "types": [
            {
                "name": "Sorting Algorithms",
                "description": "Arranges data in a specific order",
                "algorithms": [
                    {
                        "name": "Bubble Sort",
                        "description": "Simple comparison-based sorting by swapping adjacent elements",
                        "timeComplexity": {
                            "best": "O(n)",
                            "average": "O(n²)",
                            "worst": "O(n²)"
                        },
                        "spaceComplexity": "O(1)",
                        "stable": true,
                        "inPlace": true
                    },
                    {
                        "name": "Selection Sort",
                        "description": "Selects minimum element and places it at the beginning",
                        "timeComplexity": {
                            "best": "O(n²)",
                            "average": "O(n²)",
                            "worst": "O(n²)"
                        },
                        "spaceComplexity": "O(1)",
                        "stable": false,
                        "inPlace": true
                    },
                    {
                        "name": "Insertion Sort",
                        "description": "Builds sorted array one element at a time",
                        "timeComplexity": {
                            "best": "O(n)",
                            "average": "O(n²)",
                            "worst": "O(n²)"
                        },
                        "spaceComplexity": "O(1)",
                        "stable": true,
                        "inPlace": true
                    },
                    {
                        "name": "Merge Sort",
                        "description": "Divide and conquer algorithm that divides array, sorts, and merges",
                        "timeComplexity": {
                            "best": "O(n log n)",
                            "average": "O(n log n)",
                            "worst": "O(n log n)"
                        },
                        "spaceComplexity": "O(n)",
                        "stable": true,
                        "inPlace": false
                    },
                    {
                        "name": "Quick Sort",
                        "description": "Divide and conquer using pivot element",
                        "timeComplexity": {
                            "best": "O(n log n)",
                            "average": "O(n log n)",
                            "worst": "O(n²)"
                        },
                        "spaceComplexity": "O(log n)",
                        "stable": false,
                        "inPlace": true
                    },
                    {
                        "name": "Heap Sort",
                        "description": "Uses heap data structure to sort elements",
                        "timeComplexity": {
                            "best": "O(n log n)",
                            "average": "O(n log n)",
                            "worst": "O(n log n)"
                        },
                        "spaceComplexity": "O(1)",
                        "stable": false,
                        "inPlace": true
                    },
                    {
                        "name": "Bucket Sort",
                        "description": "Distributes elements into buckets and sorts individually",
                        "timeComplexity": {
                            "best": "O(n + k)",
                            "average": "O(n + k)",
                            "worst": "O(n²)"
                        },
                        "spaceComplexity": "O(n + k)",
                        "stable": true,
                        "inPlace": false
                    }
                ]
            },
            {
                "name": "Searching Algorithms",
                "description": "Finds specific values in data",
                "algorithms": [
                    {
                        "name": "Linear Search",
                        "description": "Sequential search through all elements",
                        "timeComplexity": {
                            "best": "O(1)",
                            "average": "O(n)",
                            "worst": "O(n)"
                        },
                        "spaceComplexity": "O(1)",
                        "requirement": "None - works on unsorted arrays"
                    },
                    {
                        "name": "Binary Search",
                        "description": "Divide and conquer search on sorted arrays",
                        "timeComplexity": {
                            "best": "O(1)",
                            "average": "O(log n)",
                            "worst": "O(log n)"
                        },
                        "spaceComplexity": "O(1) iterative, O(log n) recursive",
                        "requirement": "Array must be sorted"
                    }
                ]
            },
            {
                "name": "Graph Algorithms",
                "description": "Algorithms for graph traversal and analysis",
                "algorithms": [
                    {
                        "name": "Breadth-First Search (BFS)",
                        "description": "Level-by-level graph traversal using queue",
                        "timeComplexity": "O(V + E)",
                        "spaceComplexity": "O(V)",
                        "useCases": [
                            "Shortest path in unweighted graph",
                            "Level order traversal",
                            "Connected components"
                        ]
                    },
                    {
                        "name": "Depth-First Search (DFS)",
                        "description": "Deep exploration using stack or recursion",
                        "timeComplexity": "O(V + E)",
                        "spaceComplexity": "O(V)",
                        "useCases": [
                            "Topological sorting",
                            "Cycle detection",
                            "Path finding"
                        ]
                    },
                    {
                        "name": "Dijkstra's Algorithm",
                        "description": "Shortest path algorithm for weighted graphs with non-negative weights",
                        "timeComplexity": "O((V + E) log V) with priority queue",
                        "spaceComplexity": "O(V)",
                        "useCases": [
                            "GPS navigation",
                            "Network routing",
                            "Game AI pathfinding"
                        ]
                    },
                    {
                        "name": "Bellman-Ford Algorithm",
                        "description": "Shortest path algorithm that handles negative weights",
                        "timeComplexity": "O(V × E)",
                        "spaceComplexity": "O(V)",
                        "useCases": [
                            "Negative weight edges",
                            "Currency arbitrage",
                            "Network routing"
                        ]
                    },
                    {
                        "name": "Floyd-Warshall Algorithm",
                        "description": "All-pairs shortest path algorithm",
                        "timeComplexity": "O(V³)",
                        "spaceComplexity": "O(V²)",
                        "useCases": [
                            "Finding shortest paths between all pairs",
                            "Transitive closure"
                        ]
                    },
                    {
                        "name": "A* Search Algorithm",
                        "description": "Heuristic-based pathfinding algorithm",
                        "timeComplexity": "O(b^d) where b is branching factor, d is depth",
                        "useCases": [
                            "Game AI",
                            "Route planning",
                            "Puzzle solving"
                        ]
                    },
                    {
                        "name": "Kruskal's Algorithm",
                        "description": "Minimum Spanning Tree using edge sorting",
                        "timeComplexity": "O(E log E)",
                        "spaceComplexity": "O(V)",
                        "useCases": [
                            "Network design",
                            "Clustering",
                            "Approximation algorithms"
                        ]
                    },
                    {
                        "name": "Prim's Algorithm",
                        "description": "Minimum Spanning Tree using greedy approach",
                        "timeComplexity": "O((V + E) log V) with priority queue",
                        "spaceComplexity": "O(V)",
                        "useCases": [
                            "Network design",
                            "Cable laying",
                            "Clustering"
                        ]
                    }
                ]
            },
            {
                "name": "Dynamic Programming",
                "description": "Stores previous results to avoid repeated calculations",
                "examples": [
                    "Fibonacci DP",
                    "Knapsack Problem",
                    "Longest Common Subsequence",
                    "Matrix Chain Multiplication"
                ],
                "approach": "Break problem into overlapping subproblems and store solutions"
            },
            {
                "name": "Greedy Algorithms",
                "description": "Makes the best immediate choice at each step",
                "examples": [
                    "Huffman Coding",
                    "Activity Selection",
                    "Fractional Knapsack"
                ],
                "approach": "Choose locally optimal solution at each step"
            },
            {
                "name": "Backtracking",
                "description": "Tries building a solution and backtracks when it fails",
                "examples": [
                    "N-Queens",
                    "Sudoku Solver",
                    "Maze solving",
                    "Subset Sum"
                ],
                "approach": "Try possibilities and backtrack on failure"
            },
            {
                "name": "Divide and Conquer",
                "description": "Breaks problems into smaller parts, solves, then combines",
                "examples": [
                    "Merge Sort",
                    "Quick Sort",
                    "Binary Search",
                    "Strassen's Matrix Multiplication"
                ],
                "approach": "Divide, Conquer, Combine"
            }
        ],
